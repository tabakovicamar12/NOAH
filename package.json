{
  "name": "aon",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:demo": "ng serve --configuration demo",
    "dev:api": "tsx watch server/main.ts",
    "build": "ng build && node server/build.mjs",
    "build:web": "ng build",
    "build:server": "node server/build.mjs",
    "start:prod": "node dist/server/main.mjs",
    "cli": "tsx server/cli.ts",
    "cli:prod": "node dist/server/cli.mjs",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "tsx server/api-smoke.ts"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@electric-sql/pglite": "^0.3.16",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^1.19.17",
    "@huggingface/transformers": "4.3.1",
    "dexie": "^4.4.6",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide": "^1.55.0",
    "postgres": "^3.4.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  }
}

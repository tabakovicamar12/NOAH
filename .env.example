# Copy to .env and fill in. Never commit .env. Hosted platforms (Render, Vercel) take these as
# environment variables in their dashboards instead.

# --- Supabase database ---------------------------------------------------------------
# Supabase → your project → Connect (top bar) → "Connection string".
#   Render / local:  Session pooler   postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#   Vercel:          Transaction pooler (same, port 6543)
# Leave empty locally to use the embedded database in .data/pglite instead.
DATABASE_URL=

# --- Supabase storage (photos) ---------------------------------------------------------
# Supabase → Project Settings → API Keys.  URL looks like https://<ref>.supabase.co
# The service_role key is a secret: only the server may know it, never the app or the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=photos

# --- Sessions --------------------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login stays valid on a device (hours). Default 168 = 7 days.
TOKEN_TTL_HOURS=168

# --- Optional ----------------------------------------------------------------------------
# PORT=8787
# CORS_ORIGINS=https://aon.example.com      only if the app and the API live on different domains
# MAX_PHOTO_BYTES=4194304

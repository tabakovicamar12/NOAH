/* Web workers: same strictness as the app, with the worker globals instead of the DOM. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/worker",
    "lib": ["es2022", "webworker"],
    "types": []
  },
  "include": ["src/**/*.worker.ts", "src/**/*-worker.messages.ts"]
}
